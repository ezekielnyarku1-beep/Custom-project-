{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build && npm --prefix client run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__overview_path=/api/:path*" },
    { "source": "/health", "destination": "/api/index?__overview_path=/health" }
  ]
}
